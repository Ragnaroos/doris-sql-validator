# Hive 4.2.1 / HiveServer2
HIVE_HOST=127.0.0.1
HIVE_PORT=10000
HIVE_USERNAME=hive
HIVE_DATABASE=default

# PostgreSQL LIVE_SOURCE (only needed by PostgreSQL suites)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres-local-only
POSTGRES_DATABASE=dsv_validation

# Existing local Doris container
DORIS_HOST=127.0.0.1
DORIS_PORT=9030
DORIS_USERNAME=root
DORIS_PASSWORD=
DORIS_DATABASE=

# The community checkout used by uv as an editable dependency.
SQLGLOT_SOURCE_PATH=../sqlglot

