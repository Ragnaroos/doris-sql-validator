SELECT amount
FROM validation_demo_items
WHERE category = 'a';
 amount
--------
     10
     20
     20
(3 rows)

SELECT category, COUNT(*) AS row_count, COUNT(amount) AS non_null_count
FROM validation_demo_items
GROUP BY category
ORDER BY category;
 category | row_count | non_null_count
----------+-----------+----------------
 a        |         3 |              3
 b        |         2 |              1
(2 rows)
