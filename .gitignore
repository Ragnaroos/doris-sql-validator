.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
/upstream/
/inputs/
/cases/
/examples/
/reports/*
!/reports/.gitkeep
# Only the reviewed aggregates-001 Markdown/JSON reports are published.
!/reports/data-preparation/
/reports/data-preparation/*
!/reports/data-preparation/aggregates-001-data-preparation.md
!/reports/validation/
/reports/validation/*
!/reports/validation/aggregates-001-stage-*-validation.json
!/reports/attribution/
/reports/attribution/*
!/reports/attribution/aggregates-001-attribution-summary.md
!/reports/attribution/cases/
/reports/attribution/cases/*
!/reports/attribution/cases/aggregates-001/
/reports/attribution/cases/aggregates-001/*
!/reports/attribution/cases/aggregates-001/*.md
!/reports/fixes/
/reports/fixes/*
!/reports/fixes/aggregates-001-fix-*-summary.md
!/reports/fixes/tasks/
/reports/fixes/tasks/*
!/reports/fixes/tasks/aggregates-001/
/reports/fixes/tasks/aggregates-001/*
!/reports/fixes/tasks/aggregates-001/fix-*/
/reports/fixes/tasks/aggregates-001/fix-*/*
!/reports/fixes/tasks/aggregates-001/fix-*/*.md
*.sql
*.out
*.q
*.q.out
docker/hive/jars/*.jar
!docker/hive/jars/.gitkeep
